# Native cPanel production environment for https://crm.nakshatech.com
#
# Copy to /home/crmnakshatech/crm_backend/.env and chmod 600. This file is read by
# pydantic-settings (dotenv syntax); it is data for the application, never shell
# code. It is not committed, not packaged and never overwritten by deployment.
# Replace every REPLACE_ME before deployment. Docker and Compose are not used.

PRODUCTION_DEPLOY_ENABLED=false
PRODUCTION_PUBLIC_URL=https://crm.nakshatech.com
# Optional: an unrelated website used to prove deployment isolation. Empty = skip.
ISOLATION_CHECK_URL=
ENVIRONMENT=production
APP_ENV=production
APP_PUBLIC_URL=https://crm.nakshatech.com
PURCHASE_APPROVAL_PUBLIC_URL=https://crm.nakshatech.com

# Native ASGI (systemd/uvicorn) is mounted by the web server at /api, so the
# application itself registers /api/*. For the Passenger alternative set
# API_PREFIX= (empty) and ROOT_PATH=/api instead, because Passenger supplies the
# /api mount as SCRIPT_NAME.
API_PREFIX=/api
ROOT_PATH=
DOCS_ENABLED=false
BACKEND_RUNTIME=systemd
BACKEND_PORT=8010

# --- PostgreSQL (cPanel-managed local database or approved external host) ----
DATABASE_URL=postgresql+psycopg://crmnakshatech_crm:REPLACE_ME@127.0.0.1:5432/crmnakshatech_crm
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

JWT_SECRET=REPLACE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
TOTP_ISSUER=NakshaTech CRM
TOTP_ENCRYPTION_KEY=REPLACE_ME
TOTP_VALID_WINDOW=1
CORS_ORIGINS=https://crm.nakshatech.com
TRUSTED_HOSTS=crm.nakshatech.com,127.0.0.1,localhost

# --- Redis (session/queue support; cPanel-managed or approved external) ------
REDIS_URL=redis://127.0.0.1:6379/0

# --- MinIO / S3 document and attachment storage ------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME
MINIO_BUCKET=asset-files
MINIO_SECURE=false

# --- SMTP, OTP, MFA and employee portal --------------------------------------
ALLOWED_EMAIL_DOMAINS=nakshatech.com
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM_EMAIL=REPLACE_ME
SMTP_FROM_NAME=NakshaTech CRM
SMTP_USE_TLS=true
SMTP_USE_SSL=false
IT_SUPPORT_EMAIL=software.team@nakshatech.com
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_REQUESTS_PER_HOUR=5
TEMPORARY_TOKEN_MINUTES=15
EMPLOYEE_PORTAL_ENABLED=true

# Temporary privileged/role passwords. Production startup never runs the
# development seeders, so these values never reset existing employee passwords,
# MFA secrets or database records; they exist only for validated configuration
# and any administrator-reviewed first-time onboarding.
SEED_MANAGEMENT_PASSWORD=REPLACE_ME
SEED_MANAGEMENT_SECONDARY_PASSWORD=REPLACE_ME
SEED_SOFTWARE_TEAM_PASSWORD=REPLACE_ME
SEED_IT_PASSWORD=REPLACE_ME
SEED_FINANCE_PASSWORD=REPLACE_ME
SEED_HR_PASSWORD=REPLACE_ME

# --- Mandatory production safety switches ------------------------------------
SEED_DEFAULT_USERS=false
SEED_OPERATIONS_TEST_USERS_ENABLED=false
ENABLE_TEST_EMPLOYEE_SEED=false
ENABLE_UAT_2026_CONTROLS=false
LOCAL_TEST_AUTH_BYPASS=false

# --- Backups and background work --------------------------------------------
BACKUP_ROOT=/home/crmnakshatech/erp-backups
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_DATABASE_ENABLED=true
BACKUP_MINIO_ENABLED=false
BACKUP_DAILY_RETENTION_DAYS=90
BACKUP_DATABASE_RETENTION_DAYS=30
BACKUP_COMMAND_TIMEOUT_SECONDS=1800
PG_DUMP_BIN=/usr/bin/pg_dump
LOCAL_BACKUP_AGENT_ENABLED=false
ENABLE_BACKGROUND_WATCHER=false

# --- Optional read-only Naksha Copilot (backend only) -----------------------
NAKSHA_COPILOT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NAKSHA_COPILOT_TIMEOUT_SECONDS=25
NAKSHA_COPILOT_REQUESTS_PER_HOUR=20
NAKSHA_COPILOT_MAX_OUTPUT_TOKENS=900
