# Copy to /home/crmnakshatech/erp-production/shared/production.env, chmod 600.
# Never source this as shell code. Compose reads dotenv syntax.
PRODUCTION_DEPLOY_ENABLED=false
PRODUCTION_ROOT=/home/crmnakshatech/erp-production
PRODUCTION_HTTP_PORT=18090
PRODUCTION_PUBLIC_URL=https://crm.nakshatech.com
# Administrator supplies an existing unrelated website URL for isolation verification.
ISOLATION_CHECK_URL=REPLACE_ME
ENVIRONMENT=production
APP_ENV=production
APP_PUBLIC_URL=https://crm.nakshatech.com
PURCHASE_APPROVAL_PUBLIC_URL=https://crm.nakshatech.com
API_PREFIX=/api
ROOT_PATH=
DOCS_ENABLED=false
POSTGRES_DB=nakshatech_crm
POSTGRES_USER=nakshatech_crm
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql+psycopg://nakshatech_crm:REPLACE_ME@db:5432/nakshatech_crm
JWT_SECRET=REPLACE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
TOTP_ENCRYPTION_KEY=REPLACE_ME
CORS_ORIGINS=https://crm.nakshatech.com
TRUSTED_HOSTS=crm.nakshatech.com,localhost,127.0.0.1,backend
ALLOWED_EMAIL_DOMAINS=nakshatech.com
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME
MINIO_BUCKET=asset-files
MINIO_SECURE=false
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM_EMAIL=REPLACE_ME
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SEED_DEFAULT_USERS=false
SEED_OPERATIONS_TEST_USERS_ENABLED=false
ENABLE_TEST_EMPLOYEE_SEED=false
ENABLE_UAT_2026_CONTROLS=false
LOCAL_TEST_AUTH_BYPASS=false
SEED_MANAGEMENT_PASSWORD=REPLACE_ME
SEED_MANAGEMENT_SECONDARY_PASSWORD=REPLACE_ME
SEED_SOFTWARE_TEAM_PASSWORD=REPLACE_ME
SEED_IT_PASSWORD=REPLACE_ME
SEED_FINANCE_PASSWORD=REPLACE_ME
SEED_HR_PASSWORD=REPLACE_ME
BACKUP_ROOT=/backups
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_DATABASE_ENABLED=false
BACKUP_MINIO_ENABLED=false
LOCAL_BACKUP_AGENT_ENABLED=false
NAKSHA_COPILOT_ENABLED=false
ENABLE_BACKGROUND_WATCHER=true
# Uvicorn default info logs go to rotating Docker logs.
