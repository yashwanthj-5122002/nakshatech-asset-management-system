# Copy these values into the cPanel Application Manager environment or into
# backend/.env outside public_html. Replace every placeholder before launch.
DATABASE_URL=postgresql+psycopg://CPANEL_DB_USER:STRONG_PASSWORD@localhost:5432/CPANEL_DB_NAME
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=https://assets.example.com

# Store backup files under the private cPanel account home, never public_html.
BACKUP_ROOT=/home/CPANEL_USER/nakshatech_backups
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_DATABASE_ENABLED=true
BACKUP_MINIO_ENABLED=false
BACKUP_DAILY_RETENTION_DAYS=90
BACKUP_DATABASE_RETENTION_DAYS=30
BACKUP_COMMAND_TIMEOUT_SECONDS=1800
PG_DUMP_BIN=/usr/bin/pg_dump

# Use external/supported services when direct cPanel hosting does not provide them.
MINIO_ENDPOINT=minio.example.com:443
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
MINIO_BUCKET=asset-files
MINIO_SECURE=true
REDIS_URL=redis://127.0.0.1:6379/0
