# Native cPanel backend environment reference.
#
# The canonical, complete template is ../.env.production.example. Prefer it:
# copy it to /home/crmnakshatech/crm_backend/.env and set mode 600.
#
# Only the values that differ between the two supported native runtimes are
# repeated here. Docker and Compose hostnames (db, redis, minio) do not exist on
# the production server.
#
# --- systemd + Uvicorn (preferred) ------------------------------------------
BACKEND_RUNTIME=systemd
BACKEND_PORT=8010
API_PREFIX=/api
ROOT_PATH=
#
# --- Passenger WSGI alternative --------------------------------------------
# BACKEND_RUNTIME=passenger
# API_PREFIX=
# ROOT_PATH=/api
#
# --- Native service endpoints (cPanel-managed or approved external) --------
# DATABASE_URL=postgresql+psycopg://CPANEL_DB_USER:STRONG_PASSWORD@127.0.0.1:5432/CPANEL_DB_NAME
# REDIS_URL=redis://127.0.0.1:6379/0
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_BUCKET=asset-files
# MINIO_SECURE=false
#
# --- Private account paths --------------------------------------------------
BACKUP_ROOT=/home/crmnakshatech/erp-backups
PG_DUMP_BIN=/usr/bin/pg_dump
#
# --- Production safety switches (must stay false) ---------------------------
SEED_DEFAULT_USERS=false
SEED_OPERATIONS_TEST_USERS_ENABLED=false
ENABLE_TEST_EMPLOYEE_SEED=false
ENABLE_UAT_2026_CONTROLS=false
LOCAL_TEST_AUTH_BYPASS=false
