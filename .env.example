# POSTGRES_DB=asset_management
# POSTGRES_USER=asset_user
# POSTGRES_PASSWORD=<change-me>
# DATABASE_URL=postgresql+psycopg://asset_user:<change-me>@db:5432/asset_management
# JWT_SECRET=<generate-secure-secret>
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_MINUTES=480
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=<change-me>
# MINIO_ENDPOINT=minio:9000
# MINIO_BUCKET=asset-files
# CORS_ORIGINS=http://localhost:3100,http://localhost:8088
# APP_ENV=development

# # --------------------------------------------------------------------------
# # DEVELOPMENT-ONLY common login password.
# # For local development/testing, every SEED_*_PASSWORD / TEST_EMPLOYEE_SEED_PASSWORD
# # value below is normally set to the SAME shared value (DEV_COMMON_LOGIN_PASSWORD)
# # so every intended test/dev ERP account authenticates with one password. This is
# # NOT a production password policy -- production must use individual temporary
# # credentials with a mandatory first-login password change. NEVER put the real
# # development password in this example file; use a private .env instead.
# # --------------------------------------------------------------------------
# DEV_COMMON_LOGIN_PASSWORD=<set-in-local-env>

# # V8.1 local/test-only normal Employee fixtures. Never enable in production.
# ENABLE_TEST_EMPLOYEE_SEED=false
# TEST_EMPLOYEE_SEED_PASSWORD=<set-in-local-env>

# # Authoritative provisioned role accounts. Admin keeps its existing password;
# # Software Team, IT, Finance and HR use temporary passwords only until first-time
# # activation (Finance/HR/IT/Software Team are auto-reset to this value on every
# # backend startup until an Authenticator/MFA credential is confirmed).
# SEED_ADMIN_EMAIL=admin@nakshatech.com
# SEED_ADMIN_PASSWORD=<set-in-local-env>
# SEED_SOFTWARE_TEAM_EMAIL=software.team@nakshatech.com
# SEED_SOFTWARE_TEAM_PASSWORD=<set-in-local-env>
# SEED_IT_EMAIL=it-support@nakshatech.com
# SEED_IT_PASSWORD=<set-in-local-env>
# SEED_FINANCE_PASSWORD=<set-in-local-env>
# SEED_HR_PASSWORD=<set-in-local-env>

# # Authoritative Management accounts. Generate private temporary passwords with
# # GENERATE_MANAGEMENT_TEMP_PASSWORDS_WINDOWS.ps1 before first login. Existing
# # activated Management accounts keep their password hash across restarts.
# SEED_MANAGEMENT_EMAIL=vinod@nakshatech.com
# SEED_MANAGEMENT_PASSWORD=<set-in-local-env>
# SEED_MANAGEMENT_SECONDARY_EMAIL=chethan@nakshatech.com
# SEED_MANAGEMENT_SECONDARY_PASSWORD=<set-in-local-env>

# # Local/UAT-only workflow test logins (BD manager, Ortho PM, normal employee).
# # Development-only; production configuration rejects enabling this.
# SEED_OPERATIONS_TEST_USERS_ENABLED=false
# SEED_BD_MANAGER_EMAIL=bd@nakshatech.com
# SEED_BD_MANAGER_PASSWORD=<set-in-local-env>
# SEED_ORTHO_PM_EMAIL=ortho@nakshatech.com
# SEED_ORTHO_PM_PASSWORD=<set-in-local-env>
# SEED_EMPLOYEE_TEST_EMAIL=employee1@nakshatech.com
# SEED_EMPLOYEE_TEST_PASSWORD=<set-in-local-env>

# # Drone department seed account.
# SEED_DRONE_EMAIL=drone@nakshatech.com
# SEED_DRONE_PASSWORD=<set-in-local-env>

# # Backup configuration
# # cPanel recommended: /home/<cpanel-user>/nakshatech_backups (outside public_html)
# BACKUP_ROOT=/backups
# BACKUP_HOST_PATH=../NAKSHA_BACKUPS
# BACKUP_TIMEZONE=Asia/Kolkata
# BACKUP_DATABASE_ENABLED=true
# BACKUP_MINIO_ENABLED=false
# BACKUP_DAILY_RETENTION_DAYS=90
# BACKUP_DATABASE_RETENTION_DAYS=30
# BACKUP_COMMAND_TIMEOUT_SECONDS=1800
# PG_DUMP_BIN=pg_dump

# # Local Windows backup agent (set in deployed production environment)
# LOCAL_BACKUP_AGENT_ENABLED=false
# LOCAL_BACKUP_AGENT_TOKEN=<set-in-local-env>

# # Employee organization access and zero-SMS-cost authentication
# EMPLOYEE_PORTAL_ENABLED=true
# ALLOWED_EMAIL_DOMAINS=nakshatech.com
# EMAIL_DELIVERY_MODE=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@nakshatech.com
# SMTP_FROM_NAME=NakshaTech CRM
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# IT_SUPPORT_EMAIL=software.team@nakshatech.com
# TICKET_EMAIL_HEADING=NakshaTech IT Support
# FINANCE_EMAIL_HEADING=NakshaTech Finance CRM
# FINANCE_ADMIN_NOTIFICATION_EMAILS=admin@nakshatech.com
# FINANCE_TEAM_NOTIFICATION_EMAILS=finance@nakshatech.com
# APP_PUBLIC_URL=http://localhost:3100
# EMAIL_OTP_EXPIRY_MINUTES=10
# EMAIL_OTP_RESEND_SECONDS=60
# EMAIL_OTP_MAX_ATTEMPTS=5
# EMAIL_OTP_MAX_REQUESTS_PER_HOUR=5
# TEMPORARY_TOKEN_MINUTES=15
# TOTP_ISSUER=NakshaTech CRM
# TOTP_ENCRYPTION_KEY=<generate-secure-secret>
# TOTP_VALID_WINDOW=1

# # Purchase approval email channel.
# # During UAT set PURCHASE_APPROVAL_PUBLIC_URL to a URL reachable by the test
# # approver (not localhost on another person's computer). Leave it blank to use
# # APP_PUBLIC_URL. Production should use the deployed Asset Management URL.
# PURCHASE_APPROVAL_PUBLIC_URL=
# PURCHASE_APPROVAL_EMAIL_HEADING=NakshaTech Purchase Approval
# PURCHASE_APPROVAL_EMAIL_TOKEN_HOURS=72

# # Naksha Copilot (backend only; never expose GEMINI_API_KEY through VITE_* variables)
# NAKSHA_COPILOT_ENABLED=false
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# NAKSHA_COPILOT_TIMEOUT_SECONDS=25
# NAKSHA_COPILOT_REQUESTS_PER_HOUR=20
# NAKSHA_COPILOT_MAX_OUTPUT_TOKENS=900

# # Software Team Agent Monitoring gateway.
# # In local Docker development, docker-compose.yml defaults this preferred URL to
# # the authoritative System Manager v1.5 backend published on the Windows host.
# # The System Manager UI is normally http://localhost:3001 and its API backend is
# # normally http://localhost:8000. AGENT_MONITOR_ADMIN_KEY must match the active
# # System Manager backend ADMIN_API_KEY; keep that credential backend-only.
# AGENT_MONITOR_ENABLED=true
# AGENT_MONITOR_BASE_URL=http://192.168.10.94:3001
# AGENT_MONITOR_ADMIN_KEY=<generate-secure-secret>
# PURCHASE_APPROVAL_PUBLIC_URL=http://192.168.10.81:8088
POSTGRES_DB=asset_management
POSTGRES_USER=asset_user
POSTGRES_PASSWORD=<change-me>
DATABASE_URL=postgresql+psycopg://asset_user:<change-me>@db:5432/asset_management

APP_ENV=development

JWT_SECRET=<generate-secure-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<change-me>
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=asset-files

CORS_ORIGINS=http://localhost:3100,http://localhost:8088,http://192.168.10.81:8088

# ============================================================
# DEVELOPMENT / UAT COMMON LOGIN
# ============================================================

# Development/testing only.
# All intended ERP test accounts use the same password.
DEV_COMMON_LOGIN_PASSWORD=<set-in-local-env>

SEED_ADMIN_EMAIL=admin@nakshatech.com
SEED_ADMIN_PASSWORD=<set-in-local-env>

SEED_IT_EMAIL=it-support@nakshatech.com
SEED_IT_PASSWORD=<set-in-local-env>

SEED_MANAGEMENT_EMAIL=vinod@nakshatech.com
SEED_MANAGEMENT_PASSWORD=<set-in-local-env>

SEED_MANAGEMENT_SECONDARY_EMAIL=chethan@nakshatech.com
SEED_MANAGEMENT_SECONDARY_PASSWORD=<set-in-local-env>

SEED_SOFTWARE_TEAM_EMAIL=software.team@nakshatech.com
SEED_SOFTWARE_TEAM_PASSWORD=<set-in-local-env>

SEED_FINANCE_PASSWORD=<set-in-local-env>
SEED_HR_PASSWORD=<set-in-local-env>

SEED_DRONE_EMAIL=drone@nakshatech.com
SEED_DRONE_PASSWORD=<set-in-local-env>

# ============================================================
# V8.1 WORKFLOW TEST ACCOUNTS
# ============================================================

SEED_OPERATIONS_TEST_USERS_ENABLED=true

SEED_BD_MANAGER_EMAIL=bd@nakshatech.com
SEED_BD_MANAGER_PASSWORD=<set-in-local-env>

SEED_ORTHO_PM_EMAIL=ortho@nakshatech.com
SEED_ORTHO_PM_PASSWORD=<set-in-local-env>

SEED_EMPLOYEE_TEST_EMAIL=employee1@nakshatech.com
SEED_EMPLOYEE_TEST_PASSWORD=<set-in-local-env>

# employee1.test through employee15.test
ENABLE_TEST_EMPLOYEE_SEED=true
TEST_EMPLOYEE_SEED_PASSWORD=<set-in-local-env>

# ============================================================
# EMPLOYEE PORTAL / AUTH
# ============================================================

EMPLOYEE_PORTAL_ENABLED=true
ALLOWED_EMAIL_DOMAINS=nakshatech.com

EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_REQUESTS_PER_HOUR=5
TEMPORARY_TOKEN_MINUTES=15

# ============================================================
# EMAIL / SMTP
# ============================================================

EMAIL_DELIVERY_MODE=smtp

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<set-in-local-env>
SMTP_PASSWORD=<set-in-local-env>
SMTP_FROM_EMAIL=software.team@nakshatech.com
SMTP_FROM_NAME=Nakshatech CRM

SMTP_USE_TLS=true
SMTP_USE_SSL=false

IT_SUPPORT_EMAIL=software.team@nakshatech.com

TICKET_EMAIL_HEADING=Nakshatech IT Support
FINANCE_EMAIL_HEADING=Nakshatech Finance CRM

FINANCE_ADMIN_NOTIFICATION_EMAILS=admin@nakshatech.com
FINANCE_TEAM_NOTIFICATION_EMAILS=finance@nakshatech.com

# Public URL used in links generated by the ERP during UAT.
APP_PUBLIC_URL=http://192.168.10.81:8088

# ============================================================
# MFA / TOTP
# ============================================================

TOTP_ISSUER=Nakshatech CRM
TOTP_ENCRYPTION_KEY=<generate-secure-secret>
TOTP_VALID_WINDOW=4

# ============================================================
# PURCHASE APPROVAL
# ============================================================

PURCHASE_APPROVAL_PUBLIC_URL=http://192.168.10.81:8088
PURCHASE_APPROVAL_EMAIL_HEADING=Nakshatech Purchase Approval
PURCHASE_APPROVAL_EMAIL_TOKEN_HOURS=72

# ============================================================
# BACKUP CONFIGURATION
# ============================================================

BACKUP_ROOT=/backups
BACKUP_HOST_PATH=../NAKSHA_BACKUPS
BACKUP_TIMEZONE=Asia/Kolkata

BACKUP_DATABASE_ENABLED=true
BACKUP_MINIO_ENABLED=false

BACKUP_DAILY_RETENTION_DAYS=90
BACKUP_DATABASE_RETENTION_DAYS=30
BACKUP_COMMAND_TIMEOUT_SECONDS=1800

PG_DUMP_BIN=pg_dump

LOCAL_BACKUP_AGENT_ENABLED=false
LOCAL_BACKUP_AGENT_TOKEN=<set-in-local-env>

# ============================================================
# NAKSHA COPILOT
# ============================================================

NAKSHA_COPILOT_ENABLED=true
GEMINI_API_KEY=<set-in-local-env>
GEMINI_MODEL=gemini-2.5-flash-lite

NAKSHA_COPILOT_TIMEOUT_SECONDS=60
NAKSHA_COPILOT_REQUESTS_PER_HOUR=20
NAKSHA_COPILOT_MAX_OUTPUT_TOKENS=900

# ============================================================
# SOFTWARE TEAM AGENT MONITOR
# ============================================================

AGENT_MONITOR_ENABLED=true
AGENT_MONITOR_BASE_URL=http://192.168.10.94:3001
AGENT_MONITOR_ADMIN_KEY=<generate-secure-secret>