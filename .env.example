POSTGRES_DB=asset_management
POSTGRES_USER=asset_user
POSTGRES_PASSWORD=asset_password
DATABASE_URL=postgresql+psycopg://asset_user:asset_password@db:5432/asset_management
JWT_SECRET=change-this-secret-before-production-with-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=asset-files
CORS_ORIGINS=http://localhost:3100,http://localhost:8088

# Authoritative provisioned role accounts. Admin keeps its existing password;
# Software Team and IT use temporary passwords only until first-time activation.
SEED_ADMIN_EMAIL=admin@nakshatech.com
SEED_ADMIN_PASSWORD=replace-with-current-private-admin-password
SEED_SOFTWARE_TEAM_EMAIL=software.team@nakshatech.com
SEED_SOFTWARE_TEAM_PASSWORD=replace-with-private-temporary-password
SEED_IT_EMAIL=it-support@nakshatech.com
SEED_IT_PASSWORD=replace-with-private-temporary-password
SEED_FINANCE_PASSWORD=replace-with-private-temporary-password

# Authoritative Management accounts. Generate private temporary passwords with
# GENERATE_MANAGEMENT_TEMP_PASSWORDS_WINDOWS.ps1 before first login.
SEED_MANAGEMENT_EMAIL=vinod@nakshatech.com
SEED_MANAGEMENT_PASSWORD=replace-with-private-temporary-password
SEED_MANAGEMENT_SECONDARY_EMAIL=chethan@nakshatech.com
SEED_MANAGEMENT_SECONDARY_PASSWORD=replace-with-private-temporary-password

# Backup configuration
# cPanel recommended: /home/<cpanel-user>/nakshatech_backups (outside public_html)
BACKUP_ROOT=/backups
BACKUP_HOST_PATH=../NAKSHA_BACKUPS
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_DATABASE_ENABLED=true
BACKUP_MINIO_ENABLED=false
BACKUP_DAILY_RETENTION_DAYS=90
BACKUP_DATABASE_RETENTION_DAYS=30
BACKUP_COMMAND_TIMEOUT_SECONDS=1800
PG_DUMP_BIN=pg_dump

# Local Windows backup agent (set in deployed production environment)
LOCAL_BACKUP_AGENT_ENABLED=false
LOCAL_BACKUP_AGENT_TOKEN=replace-with-a-random-token-of-at-least-32-characters

# Employee organization access and zero-SMS-cost authentication
EMPLOYEE_PORTAL_ENABLED=true
ALLOWED_EMAIL_DOMAINS=nakshatech.com
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@nakshatech.com
SMTP_FROM_NAME=NakshaTech CRM
SMTP_USE_TLS=true
SMTP_USE_SSL=false
IT_SUPPORT_EMAIL=software.team@nakshatech.com
TICKET_EMAIL_HEADING=NakshaTech IT Support
FINANCE_EMAIL_HEADING=NakshaTech Finance CRM
FINANCE_ADMIN_NOTIFICATION_EMAILS=admin@nakshatech.com
FINANCE_TEAM_NOTIFICATION_EMAILS=finance@nakshatech.com
APP_PUBLIC_URL=http://localhost:3100
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_REQUESTS_PER_HOUR=5
TEMPORARY_TOKEN_MINUTES=15
TOTP_ISSUER=NakshaTech CRM
TOTP_ENCRYPTION_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
TOTP_VALID_WINDOW=1

# Purchase approval email channel.
# During UAT set PURCHASE_APPROVAL_PUBLIC_URL to a URL reachable by the test
# approver (not localhost on another person's computer). Leave it blank to use
# APP_PUBLIC_URL. Production should use the deployed Asset Management URL.
PURCHASE_APPROVAL_PUBLIC_URL=
PURCHASE_APPROVAL_EMAIL_HEADING=NakshaTech Purchase Approval
PURCHASE_APPROVAL_EMAIL_TOKEN_HOURS=72

# Naksha Copilot (backend only; never expose GEMINI_API_KEY through VITE_* variables)
NAKSHA_COPILOT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NAKSHA_COPILOT_TIMEOUT_SECONDS=25
NAKSHA_COPILOT_REQUESTS_PER_HOUR=20
NAKSHA_COPILOT_MAX_OUTPUT_TOKENS=900

# Software Team Agent Monitoring gateway.
# In local Docker development, docker-compose.yml defaults this preferred URL to
# the authoritative System Manager v1.5 backend published on the Windows host.
# The System Manager UI is normally http://localhost:3001 and its API backend is
# normally http://localhost:8000. AGENT_MONITOR_ADMIN_KEY must match the active
# System Manager backend ADMIN_API_KEY; keep that credential backend-only.
AGENT_MONITOR_ENABLED=true
AGENT_MONITOR_PREFERRED_BASE_URL=http://host.docker.internal:8000
AGENT_MONITOR_BASE_URL=
AGENT_MONITOR_ADMIN_KEY=replace-with-the-active-system-manager-admin-api-key
